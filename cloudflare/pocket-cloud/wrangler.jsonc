{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pocket-cloud-account",
  "main": "src/index.js",
  "compatibility_date": "2026-07-31",
  "workers_dev": true,
  "preview_urls": true,
  "assets": { "directory": "public", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [{ "binding": "DB", "database_name": "pocket-cloud", "database_id": "REPLACE_WITH_D1_DATABASE_ID", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "DOWNLOADS", "bucket_name": "pocket-desktop-releases", "preview_bucket_name": "pocket-desktop-releases-preview" }],
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
